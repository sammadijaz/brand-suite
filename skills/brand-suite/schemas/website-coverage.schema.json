{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "budget": {
      "type": "integer"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unreviewed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "budget",
    "pages",
    "unreviewed",
    "mode"
  ]
}

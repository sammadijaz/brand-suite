{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "mode": {
      "type": "string"
    },
    "complete": {
      "type": "boolean"
    },
    "entity_id": {
      "type": "string"
    },
    "input_hash": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "mode",
    "complete",
    "entity_id",
    "input_hash",
    "documents",
    "artifacts",
    "blockers"
  ]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[GS PACF][0-9]{2}$"
          },
          "title": {
            "type": "string"
          },
          "folder": {
            "type": "string"
          },
          "formats": {
            "const": [
              "html",
              "pdf",
              "docx"
            ]
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "applicability": {
            "type": "string"
          },
          "risk_gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inapplicable": {
            "type": "string"
          },
          "required_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optional_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "folder",
          "formats",
          "sections",
          "applicability",
          "risk_gates",
          "inapplicable",
          "required_fields",
          "optional_fields"
        ]
      }
    }
  },
  "required": [
    "version",
    "documents"
  ]
}

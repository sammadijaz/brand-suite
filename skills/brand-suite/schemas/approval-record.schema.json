{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "state": {
      "const": "NOT_APPROVED"
    },
    "reviewer": {
      "type": "null"
    },
    "evidence": {
      "type": "null"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "state",
    "reviewer",
    "evidence",
    "reason"
  ]
}
